# ==============================================================
# Backend configuration example file.
# Copy this file to ".env" and change the values for your machine.
#
#   cp .env.example .env
# ==============================================================

# --- PostgreSQL connection string (RECOMMENDED for the project) ---
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME
# Replace "postgres", "your_password" and "appointment_db" with your own
# values (the ones you set when installing PostgreSQL).
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/appointment_db

# --- SQLite alternative (quick demo, no PostgreSQL needed) ---
# Uncomment the line below and comment out the PostgreSQL line above if
# you want to try the app with zero database setup.
# DATABASE_URL=sqlite:///./app.db

# --- Security settings ---
# In production use a long, random string.
SECRET_KEY=change-me-to-a-long-random-string

# JWT algorithm and token lifetime in minutes (1440 = 24 hours).
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
